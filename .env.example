# Referência das variáveis de ambiente que application.yml aceita (todas via ${VAR:default}).
#
# Diferente do frontend (cliente-facil-next), o Spring Boot NÃO carrega este arquivo sozinho — não
# existe nenhuma lib de dotenv no pom.xml. Isso aqui é só um checklist: os valores de verdade vêm do
# `environment:` do serviço "backend" em cliente-facil-docker/docker-compose.yml (dev local) ou de um
# cofre de segredos de verdade (deploy real). Use este arquivo como referência do que existe, não
# como algo que basta copiar pra `.env` e esperar que funcione.

# --- Banco de dados ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/clientefacil
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=admin

# --- RabbitMQ ---
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# --- Servidor ---
SERVER_PORT=8080

# Nenhum valor default no application.yml (ao contrário de todas as outras abaixo) — sem essa env, a
# aplicação sobe sem nenhum profile ativo. Ver SecretConfigurationGuard: só passa a importar de
# verdade se um dia existir um profile "prod"/"production"/"staging".
SPRING_PROFILES_ACTIVE=docker

# --- Segredos: os dois valores de exemplo abaixo são os mesmos hardcoded no application.yml —
# funcionam pra dev, mas SecretConfigurationGuard recusa subir a aplicação se algum dos dois
# continuar assim num profile que pareça produção. Gere valores de verdade antes de qualquer deploy
# real (32 bytes/caracteres — os dois viram chave AES-256/HMAC).
JWT_SECRET=12345678901234567890123456789012
MAIL_CONFIG_ENCRYPTION_KEY=12345678901234567890123456789012

# --- URL do front, usada só pra montar os links dos e-mails de confirmação/recuperação de senha ---
APP_FRONTEND_URL=http://localhost:3000

# --- SMTP usado pela config base do sistema (fallback pra empresa sem mail_config própria — ver
# docs/guides/1_messaging-and-websocket.md, Parte 8). Aponta pro MailHog em dev (sem auth/TLS); numa
# config real, editável depois via PUT /api/v1/mail-configs/base, não precisa mudar essas envs.
MAIL_DEFAULT_HOST=localhost
MAIL_DEFAULT_PORT=1025
MAIL_DEFAULT_FROM_NAME=Cliente Fácil
MAIL_DEFAULT_FROM_ADDRESS=no-reply@clientefacil.local
